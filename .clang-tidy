
Checks:            'bugprone-*,
                    clang-analyzer-*,
                    performance-*,
                    portability-*,
                    modernize-*,
                      -modernize-use-trailing-return-type,
                    cert-*,
                    readability-*,
                      -readability-identifier-length,
                      -readability-magic-numbers,
                    cppcoreguidelines-*,
                    concurrency-*,
                    misc-*'
FormatStyle:       none
