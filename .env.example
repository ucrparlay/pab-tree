# Settings for docker compose: copy to .env. docker-run.sh does not read it.

# Host directory for the datasets, mounted at /data
DATA_PATH=/mnt/large-disk/pab-tree

# Your user and group (id -u, id -g), so the results stay yours
AE_UID=1000
AE_GID=1000

# Entries per synthetic dataset; the paper uses 1e9
INPUT_SIZE=1000000000

# 1 also runs Mass-tree and Bw-tree (Fig. 4, 5, 9)
WITH_MASSTREE_BWTREE=0
